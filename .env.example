# Optional: enables Gemini claim analysis. Keep all keys server-only; never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# local is the development default. Set supabase in Vercel only after applying the migration.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Do not expose this key in browser code, build args, or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for a future market-data adapter; no provider is implemented.
MARKET_DATA_API_KEY=
